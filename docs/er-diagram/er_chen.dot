graph ER {
  graph [layout=neato, splines=true, overlap=false, bgcolor="white", pad="0.4",
         fontname="Helvetica", label=<<B>ER Diagram — Personal Expense Splitting App (Chen notation)</B>>,
         labelloc=t, fontsize=22];
  node  [fontname="Helvetica", fontsize=13, style=filled, penwidth=1.4];
  edge  [fontname="Helvetica-Bold", fontsize=14, color="#333333", penwidth=1.3];

  /* ---------- entities ---------- */
  node [shape=box, fillcolor="#CFE8DD", color="#0B6E4F", width=1.8, height=0.65, fontsize=15];
  USER       [label=<<B>USER</B>>,       pos="12,0!"];
  GROUP      [label=<<B>GROUP</B>>,      pos="0,0!"];
  EXPENSE    [label=<<B>EXPENSE</B>>,    pos="6,6!"];
  SETTLEMENT [label=<<B>SETTLEMENT</B>>, pos="6,-6.2!"];

  /* ---------- relationships ---------- */
  node [shape=diamond, fillcolor="#FFE9B8", color="#B7791F", width=1.9, height=0.95, fontsize=12];
  CREATES   [label=<<B>CREATES</B>>,   pos="6,1.3!"];
  MEMBER_OF [label=<<B>MEMBER_OF</B>>, pos="6,-1.3!"];
  CONTAINS  [label=<<B>CONTAINS</B>>,  pos="2.4,3.6!"];
  PAYS      [label=<<B>PAYS</B>>,      pos="8.4,3.3!"];
  SHARES_IN [label=<<B>SHARES_IN</B>>, pos="11.4,4.4!"];
  RECORDS   [label=<<B>RECORDS</B>>,   pos="2.4,-3.7!"];
  SENDS     [label=<<B>SENDS</B>>,     pos="8.4,-3.4!"];
  RECEIVES  [label=<<B>RECEIVES</B>>,  pos="11.4,-4.6!"];

  /* ---------- attributes ---------- */
  node [shape=ellipse, fillcolor="#EEF2F7", color="#4A5568", width=1.3, height=0.5, fontsize=12];
  /* USER */
  u_id    [label=<<U>user_id</U>>, pos="15.2,1.6!"];
  u_name  [label="name",           pos="15.6,0.55!"];
  u_email [label="email",          pos="15.6,-0.5!"];
  u_phone [label="phone",          pos="15.2,-1.55!"];
  u_cat   [label="created_at",     pos="13.9,-2.45!"];
  /* GROUP */
  g_id    [label=<<U>group_id</U>>, pos="-3.2,1.6!"];
  g_name  [label="name",            pos="-3.6,0.55!"];
  g_desc  [label="description",     pos="-3.6,-0.5!"];
  g_cur   [label="currency",        pos="-3.2,-1.55!"];
  g_cat   [label="created_at",      pos="-1.9,-2.45!"];
  /* EXPENSE */
  e_id    [label=<<U>expense_id</U>>, pos="2.6,7.6!"];
  e_desc  [label="description",       pos="3.6,8.6!"];
  e_cat   [label="category",          pos="5.1,9.2!"];
  e_amt   [label="amount",            pos="6.9,9.2!"];
  e_split [label="split_type",        pos="8.4,8.6!"];
  e_date  [label="expense_date",      pos="9.5,7.6!"];
  e_cr    [label="created_at",        pos="9.0,6.3!"];
  /* SETTLEMENT */
  s_id    [label=<<U>settlement_id</U>>, pos="3.2,-7.8!"];
  s_amt   [label="amount",               pos="4.8,-8.7!"];
  s_meth  [label="method",               pos="6.6,-8.9!"];
  s_note  [label="note",                 pos="8.3,-8.5!"];
  s_at    [label="settled_at",           pos="9.4,-7.5!"];
  /* relationship attributes */
  m_role  [label="role",        pos="3.9,-2.2!"];
  m_join  [label="joined_at",   pos="6,-2.85!"];
  m_bal   [label="balance",     pos="8.1,-2.0!", style="filled,dashed"];
  p_share [label="share",       pos="13.6,5.4!"];

  /* ---------- attribute links ---------- */
  edge [penwidth=1, color="#718096", label=""];
  USER -- u_id; USER -- u_name; USER -- u_email; USER -- u_phone; USER -- u_cat;
  GROUP -- g_id; GROUP -- g_name; GROUP -- g_desc; GROUP -- g_cur; GROUP -- g_cat;
  EXPENSE -- e_id; EXPENSE -- e_desc; EXPENSE -- e_cat; EXPENSE -- e_amt;
  EXPENSE -- e_split; EXPENSE -- e_date; EXPENSE -- e_cr;
  SETTLEMENT -- s_id; SETTLEMENT -- s_amt; SETTLEMENT -- s_meth; SETTLEMENT -- s_note; SETTLEMENT -- s_at;
  MEMBER_OF -- m_role; MEMBER_OF -- m_join; MEMBER_OF -- m_bal [style=dashed];
  SHARES_IN -- p_share;

  /* ---------- relationship links with cardinality ----------
     single line = partial participation, double line = total participation */
  edge [penwidth=1.4, color="#222222", fontcolor="#C53030"];
  USER -- CREATES   [label="1"];
  CREATES -- GROUP  [label="N", color="#222222:invis:#222222"];

  USER -- MEMBER_OF  [label="M"];
  MEMBER_OF -- GROUP [label="N", color="#222222:invis:#222222"];

  GROUP -- CONTAINS   [label="1"];
  CONTAINS -- EXPENSE [label="N", color="#222222:invis:#222222"];

  USER -- PAYS     [label="1"];
  PAYS -- EXPENSE  [label="N", color="#222222:invis:#222222"];

  USER -- SHARES_IN    [label="M"];
  SHARES_IN -- EXPENSE [label="N", color="#222222:invis:#222222"];

  GROUP -- RECORDS      [label="1"];
  RECORDS -- SETTLEMENT [label="N", color="#222222:invis:#222222"];

  USER -- SENDS        [label="1"];
  SENDS -- SETTLEMENT  [label="N", color="#222222:invis:#222222"];

  USER -- RECEIVES       [label="1"];
  RECEIVES -- SETTLEMENT [label="N", color="#222222:invis:#222222"];

  /* ---------- legend ---------- */
  legend [shape=plain, style="", pos="-1.6,-7.6!", fontsize=11, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" COLOR="#A0AEC0">
      <TR><TD COLSPAN="2" ALIGN="LEFT"><B>Legend</B></TD></TR>
      <TR><TD BGCOLOR="#CFE8DD">Rectangle</TD><TD ALIGN="LEFT">Entity</TD></TR>
      <TR><TD BGCOLOR="#FFE9B8">Diamond</TD><TD ALIGN="LEFT">Relationship</TD></TR>
      <TR><TD BGCOLOR="#EEF2F7">Ellipse</TD><TD ALIGN="LEFT">Attribute (<U>underlined</U> = key)</TD></TR>
      <TR><TD BGCOLOR="#EEF2F7">Dashed ellipse</TD><TD ALIGN="LEFT">Derived attribute</TD></TR>
      <TR><TD>═══</TD><TD ALIGN="LEFT">Total participation</TD></TR>
      <TR><TD>1, N, M</TD><TD ALIGN="LEFT">Cardinality</TD></TR>
    </TABLE>>];
}
